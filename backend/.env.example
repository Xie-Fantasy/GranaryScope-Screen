# Backend runtime configuration (copy to backend/.env once and edit).
# The backend loads this file automatically at startup -- no command-line
# environment variables are needed. backend/.env is gitignored.

# --- Inference switch ------------------------------------------------------
# true  = load YOLO + read the video stream (camera stack mode)
# false = lightweight API-only mode (also the built-in default when this
#         file is absent, so a bare backend start never touches the GPU)
INFERENCE_ENABLED=true

# --- Video source ------------------------------------------------------------
# Local MediaMTX relay. Identical for camera mode and offline test mode:
# MediaMTX decides whether camera1 carries the real camera or the test video.
INFERENCE_RTSP_URL=rtsp://127.0.0.1:8554/camera1

# --- Robot monitor -----------------------------------------------------------
# LAN-B robot-monitor base address. It is not an RTSP address. The exact
# browser playback protocol and media endpoint have not yet been confirmed;
# do not append /whep or treat this as a direct video URL without that contract.
ROBOT_MONITOR_BASE_URL=http://127.0.0.1:8889/cam2/
# JPEG 抓拍根目录；启动或访问不会创建，首次有效抓拍时才会自动创建年/月/日目录。
ROBOT_CAPTURE_ROOT=D:/LiangCang

# --- Inference tuning (defaults in code; uncomment to override) --------------
# INFERENCE_DEVICE=cuda:0     # use cpu when no GPU is available
# TARGET_FPS=25               # inference cadence; 25 matches a 25fps camera
# IMGSZ=640
# CONF=0.5                    # confidence threshold; higher = fewer false hits
# CAMERA_ID=camera-01
# CLASSES=0                   # COCO class filter, comma-separated; 0 = person only;
#                             # omit to detect all 80 COCO classes

# --- API server ----------------------------------------------------------------
# The frontend auto-connects to ws://<hostname>:8000/api/v1/ws/detections;
# keep APP_PORT=8000 unless you also set VITE_DETECTION_WS_URL for the frontend.
# APP_PORT=8000
# APP_HOST=0.0.0.0   # 127.0.0.1 = local only; 0.0.0.0 = reachable from other LAN-B devices
# 仅允许本机或 192.168.31.* 网段的大屏向抓拍接口发起跨域请求。
# CORS_ALLOW_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|192\.168\.31\.\d{1,3})(?::\d+)?$
