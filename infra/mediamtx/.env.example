# Copy to infra\mediamtx\.env and fill CAMERA_RTSP_URL once. The populated
# .env is gitignored; never commit it. MediaMTX does not load this file by
# itself -- Start-MediaMTX.ps1 injects it into the MediaMTX process.

# Required: full camera RTSP URL. The credential lives only in this protected
# file and is passed to the MediaMTX child process at startup.
CAMERA_RTSP_URL=rtsp://<camera-user>:<camera-password>@<camera-lan-host>:<camera-rtsp-port>/<camera-path>

# Optional: omit (or set to 'auto') to announce every detected local IPv4
# address to WebRTC clients automatically. Set explicitly only if
# auto-detection picks a wrong interface on a multi-NIC machine.
# MEDIA_HOST=auto

# Optional: omit to derive allowed WHEP origins automatically from localhost
# and every detected local IP (Vite dev ports 2355/5173/5174). Set explicitly to
# restrict origins in production. Never use '*'.
# VUE_ORIGINS=http://localhost:2355
